{
  "name": "hermes-vitals-light",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hermes Desktop and TUI plugin: CPU, load, RAM, CPU pressure and RTT of the connected server in the status bar.",
  "license": "MIT",
  "homepage": "https://github.com/atostivint/hermes-vitals-light#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atostivint/hermes-vitals-light.git"
  },
  "bugs": {
    "url": "https://github.com/atostivint/hermes-vitals-light/issues"
  },
  "keywords": [
    "hermes",
    "plugin",
    "monitoring",
    "cpu",
    "status-bar",
    "tui"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs && node --check desktop/plugin.js && node --check tui/hermes-vitals-light.mjs",
    "test": "node --test test/load.test.mjs test/plugin.test.mjs test/tui.test.mjs",
    "install:plugin": "node scripts/build.mjs && node scripts/install.mjs"
  }
}
